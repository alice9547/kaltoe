<Window x:Class="Kaltoe.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="칼퇴 설정"
        Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Left="0" Top="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="6,3,6,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 화면이 낮으면(1024x768, 배율 150% 노트북) 세로 스크롤. 창 높이 상한은 SettingsWindow.xaml.cs 가 작업 영역 기준으로 정한다. -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,10,6,10">
        <GroupBox Header="출근 방식">
            <StackPanel>
                <RadioButton x:Name="RbFlexible" Content="유동 (처음 켠 시각)" GroupName="Mode" Margin="0,0,0,2" />
                <StackPanel x:Name="FlexiblePanel" Margin="22,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Style="{StaticResource Label}" Text="출근 인정 시작" Width="90" />
                        <TextBox x:Name="TbEarliest" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="근무 시간" Width="90" />
                        <TextBox x:Name="TbHours" Width="40" Margin="0" />
                        <TextBlock Style="{StaticResource Label}" Text="시간" Margin="4,0,0,0" />
                        <TextBox x:Name="TbMinutes" Width="40" />
                        <TextBlock Style="{StaticResource Label}" Text="분" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <RadioButton x:Name="RbFixed" Content="고정 (정해진 시각)" GroupName="Mode" Margin="0,0,0,2" />
                <StackPanel x:Name="FixedPanel" Margin="22,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="출근" Width="90" />
                        <TextBox x:Name="TbFixedStart" Margin="0" />
                        <TextBlock Style="{StaticResource Label}" Text="퇴근" Margin="14,0,0,0" />
                        <TextBox x:Name="TbFixedEnd" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="점심">
            <StackPanel>
                <CheckBox x:Name="CbLunch" Content="점심 단계 사용" Margin="0,0,0,2" />
                <StackPanel x:Name="LunchPanel" Orientation="Horizontal" Margin="22,0,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="시작" />
                    <TextBox x:Name="TbLunchStart" />
                    <TextBlock Style="{StaticResource Label}" Text="끝" Margin="14,0,0,0" />
                    <TextBox x:Name="TbLunchEnd" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="알림">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="CbNotifyLunch" Content="점심 시작" Margin="0,0,16,0" />
                <CheckBox x:Name="CbNotifyBeforeEnd" Content="퇴근 10분 전" Margin="0,0,16,0" />
                <CheckBox x:Name="CbNotifyEnd" Content="퇴근 정각" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="위젯">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Label}" Text="위젯 모양" Width="90" />
                    <RadioButton x:Name="RbTerminal" Content="터미널" GroupName="Style" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbBubble" Content="말풍선" GroupName="Style" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Label}" Text="캐릭터" Width="90" />
                    <RadioButton x:Name="RbMaltese" Content="말티즈" GroupName="Character" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbOrange" Content="주황이" GroupName="Character" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbPhoto" Content="사진" GroupName="Character" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 사진 캐릭터를 고르면 나타난다 (docs/spec.md 6-3절): 미리보기, 사진 고르기…, 기본 사진으로 -->
                <StackPanel x:Name="PhotoPanel" Orientation="Horizontal" Margin="90,0,0,4" Visibility="Collapsed">
                    <Border Width="44" Height="44" Background="#14808080" CornerRadius="4" Padding="2">
                        <Image x:Name="ImgPhotoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Button x:Name="BtnPickPhoto" Content="사진 고르기…" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center" />
                    <Button x:Name="BtnResetPhoto" Content="기본 사진으로" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TbPhotoError" Text="사진을 불러오지 못했습니다" Foreground="#D32F2F"
                           Margin="90,0,0,4" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="글자 크기" Width="90" />
                    <TextBox x:Name="TbFontSize" Width="48" Margin="0" HorizontalContentAlignment="Right" MaxLength="3" />
                    <StackPanel Margin="4,0,0,0">
                        <RepeatButton x:Name="BtnFontUp" Content="▲" Width="22" Height="14" FontSize="7" Padding="0" />
                        <RepeatButton x:Name="BtnFontDown" Content="▼" Width="22" Height="14" FontSize="7" Padding="0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="px  (8~32)" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="야근">
            <StackPanel>
                <CheckBox x:Name="CbComprehensive" Content="포괄임금제" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource Label}" Text="연장수당 단가" Width="90" />
                    <Grid>
                        <TextBox x:Name="TbRate" Width="110" Margin="0" HorizontalContentAlignment="Right" MaxLength="8" />
                        <!-- 자리표시 글자: 비어 있을 때만 보인다 -->
                        <TextBlock x:Name="RatePlaceholder" Text="최저시급 10,320" Foreground="#9E9E9E"
                                   IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Text="원" Margin="6,0,10,0" />
                    <RadioButton x:Name="RbPerHour" Content="시간당" GroupName="RateUnit" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbPerMinute" Content="분당" GroupName="RateUnit" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="비워 두면 최저시급(시간당 10,320원)으로 계산합니다. 참고용 금액입니다."
                           TextWrapping="Wrap" Foreground="#6E6E73" FontSize="12" />
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="CbLaunch" Content="로그인 시 자동 실행" Margin="0,2,0,4" />

    </StackPanel>
    </ScrollViewer>
    <!-- 미리보기·오류는 스크롤과 무관하게 항상 아래에 보인다 -->
    <StackPanel Grid.Row="1" Margin="12,0,12,8">
        <TextBlock x:Name="TbPreview" Margin="0,0,0,2" FontFamily="Cascadia Mono, Consolas, Malgun Gothic" />
        <TextBlock x:Name="TbError" Foreground="#D32F2F" TextWrapping="Wrap" MinHeight="18" />
    </StackPanel>
    </Grid>
</Window>
